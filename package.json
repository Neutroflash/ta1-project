{
  "name": "mediturno-api",
  "version": "0.1.0",
  "private": true,
  "description": "API de agendamiento de horas médicas de MediTurno (caso de estudio CI/CD)",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.js --bundle --platform=node --target=node20 --external:pg --outfile=dist/index.js",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integracion --runInBand",
    "db:migrate:deploy": "node scripts/migrate.js up",
    "db:migrate:down": "node scripts/migrate.js down"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!src/db.js"
    ]
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
